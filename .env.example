# =====================================================
# Sylvora — Variables de entorno
# =====================================================
# Copiá este archivo como .env.local y completá los valores.
# Nunca commitees .env.local con valores reales.

# -----------------------------------------------------
# Supabase
# -----------------------------------------------------
# URL del proyecto Supabase (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Anon/public key (Settings → API → Project API keys → anon public)
# Se expone al cliente — está protegida por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service Role key (Settings → API → Project API keys → service_role)
# NUNCA exponer al cliente — sin prefijo NEXT_PUBLIC_. Bypasea RLS.
# Usada por lib/supabase/server-admin.ts en route handlers que necesitan
# acciones admin (ej. invitar usuarios vía auth.admin.inviteUserByEmail).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# -----------------------------------------------------
# App
# -----------------------------------------------------
# URL pública del deploy. La usa metadataBase para resolver URLs
# absolutas en OG image, manifest, twitter cards, canonical, sitemap,
# robots y structured data (JsonLd). TODO el naming de dominio sale de
# acá — no hay dominios hardcodeados en el código.
# Dev: http://localhost:3000   |   Prod: https://sylvora.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Número de WhatsApp de soporte. Lo usa el botón "Hablar por WhatsApp"
# cuando un comercio tiene el trial vencido (TrialBlocked overlay).
# Formato internacional sin "+": 54911XXXXXXXX (cód. país + área + nro).
# Si no está seteada, el botón degrada a un link a /guia para no
# quedar muerto — pero conviene setearla en producción antes de
# mandar el link a testers reales.
NEXT_PUBLIC_SOPORTE_WHATSAPP=54911XXXXXXXX

# -----------------------------------------------------
# Mercado Pago — Cobros V1 (OAuth marketplace, Opción A)
# -----------------------------------------------------
# Sylvora NO toca dinero ni cobra comisión. Cada comerciante conecta
# SU cuenta MP vía OAuth y el dinero va directo del cliente a la
# cuenta del comerciante. Estas vars son TODAS server-only — ninguna
# lleva prefijo NEXT_PUBLIC_. Si alguna se filtra al cliente, rotala
# en el dashboard de MP y redeployá.

# Entorno: sandbox o production. Cambia logs/safety checks aunque la
# URL base de la API sea la misma. sandbox = libre para testear con
# users de prueba MP, production = real con CUIT de comerciantes.
# Default si no se setea: sandbox (defensivo).
MP_ENV=sandbox

# App de Sylvora en MP developers (https://www.mercadopago.com.ar/developers).
# Una sola app que recibe OAuth de N comerciantes. Crear en
# "Tus integraciones" → "Crear aplicación".
SYLVORA_MP_CLIENT_ID=

# Secret de la app — server-only. Visible en el detalle de la app
# después de crearla. Rotación: regenerar acá y redeployar.
SYLVORA_MP_CLIENT_SECRET=

# Redirect URI registrada en la app de MP. Debe matchear EXACTO con
# lo configurado en el dashboard MP, incluido el scheme.
# Dev:  http://localhost:3000/api/mp/oauth/callback
# Prod: https://app.sylvora.com.ar/api/mp/oauth/callback
SYLVORA_MP_REDIRECT_URI=http://localhost:3000/api/mp/oauth/callback

# Secret HMAC para validar la firma x-signature de los webhooks de MP.
# Se configura en MP developers → tu app → Notificaciones → Webhooks.
# El handler de webhook rechaza requests sin firma válida.
SYLVORA_MP_WEBHOOK_SECRET=

# Clave de cifrado app-level para los tokens OAuth en mp_credenciales.
# AES-256-GCM. Generar con:
#   openssl rand -base64 32
# 32 bytes en base64 = 44 chars terminados en "=". NO commitear la
# real. Si se filtra, rotar y forzar reconexión de todos los comercios
# (los tokens viejos quedan ilegibles).
SYLVORA_MP_TOKEN_ENCRYPTION_KEY=
