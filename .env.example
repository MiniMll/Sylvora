# =====================================================
# Sylvora — Variables de entorno
# =====================================================
# Copiá este archivo como .env.local y completá los valores.
# Nunca commitees .env.local con valores reales.

# -----------------------------------------------------
# Supabase
# -----------------------------------------------------
# URL del proyecto Supabase (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Anon/public key (Settings → API → Project API keys → anon public)
# Se expone al cliente — está protegida por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service Role key (Settings → API → Project API keys → service_role)
# NUNCA exponer al cliente. Solo se usa en el webhook de MP
# (app/api/mp/webhook/route.ts) para escribir saltando RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# -----------------------------------------------------
# Mercado Pago
# -----------------------------------------------------
# Access Token (Mercado Pago → Tus integraciones → Credenciales)
# Usar APP_USR-... para producción, TEST-... para sandbox.
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxx

# Secret Key del webhook (Webhooks → Configurar notificaciones → Clave secreta)
# Si no se setea, el webhook acepta requests sin verificar firma (modo dev).
# OBLIGATORIO en producción.
MP_WEBHOOK_SECRET=

# -----------------------------------------------------
# App
# -----------------------------------------------------
# URL pública de la app (para back_urls de MP).
# En desarrollo: http://localhost:3000
# En producción: https://tu-dominio.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
